{
  "name": "playwright-unified-automation-framework",
  "version": "1.0.0",
  "description": "Unified Enterprise Test Automation Framework for Web, Mobile, and Desktop apps with Playwright, Allure Reporting, Playwright MCP, and GitHub Copilot",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:desktop": "playwright test --project=desktop-electron",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "npm run test || true && npm run allure:generate && npm run allure:open",
    "clean:reports": "rimraf allure-results allure-report playwright-report test-results"
  },
  "keywords": [
    "playwright",
    "allure",
    "github-copilot",
    "mcp",
    "model-context-protocol",
    "desktop-testing",
    "mobile-testing",
    "web-testing",
    "electron"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.7",
    "dotenv": "^16.4.7",
    "electron": "^33.2.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
